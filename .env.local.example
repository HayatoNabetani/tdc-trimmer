# LINEログインチャネル配下に作成したLIFFアプリのID
# LINE Developers > esti チャネル > LIFF タブ で取得
#
# ⚠️ 「ID部分」だけを入れる。LIFF URL 全体を入れないこと。
#   ✅ 2010523535-hZGOJlN0
#   ❌ https://liff.line.me/2010523535-hZGOJlN0

# ペットホテル見積もり（/estimate）用
NEXT_PUBLIC_LIFF_ID=2010523535-xxxxxxxx

# トリミング見積もり（/trimming）用の別LIFFを作った場合のみ設定
# 未設定なら NEXT_PUBLIC_LIFF_ID にフォールバック
# NEXT_PUBLIC_LIFF_ID_TRIMMING=2010523535-yyyyyyyy
