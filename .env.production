# 本番ビルド（Vercel）に埋め込む LIFF ID。
# NEXT_PUBLIC_ はビルド時にクライアントへ埋め込まれる公開値（秘密ではない）。
# Vercel のダッシュボードで同名の環境変数を設定している場合はそちらが優先されるため、
# 値が食い違う場合はダッシュボード側を修正/削除すること。

# ペットホテル見積もり（/estimate）用の LIFF ID
NEXT_PUBLIC_LIFF_ID=2010523535-hZGOJlN0

# トリミング見積もり（/trimming）用の LIFF ID（別LIFFアプリを作ったら設定）。
# 未設定なら NEXT_PUBLIC_LIFF_ID にフォールバックする。
# NEXT_PUBLIC_LIFF_ID_TRIMMING=
